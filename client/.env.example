# ─── Client Environment Variables ─────────────────────────────────────────────
# Copy this file to .env and fill in real values before deploying.
# If your frontend is served from the same domain as your API (e.g. Railway/Render
# with a monorepo setup), you can leave VITE_API_URL blank — the app will use /api.

# Override the API base URL only if your API is on a different domain:
# VITE_API_URL=https://your-api-domain.com/api
